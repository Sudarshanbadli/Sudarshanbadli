  <style>
    .mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
    .label{font:700 12px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:3px}
    .small{font:12px ui-monospace,SFMono-Regular,Menlo,monospace}
    .value{font:700 18px ui-monospace,SFMono-Regular,Menlo,monospace}
    .cyan{fill:#00ffd5} .muted{fill:#71839b} .white{fill:#eaf4ff}
    .line{stroke:#1a3650;stroke-width:1} .card{fill:#091321;stroke:#1b3c54;stroke-width:1.3}
    .pulse{animation:pulse 2.2s ease-in-out infinite} 
    .float{animation:float 5s ease-in-out infinite}
    .spin{transform-box:fill-box;transform-origin:center;animation:spin 16s linear infinite}
    .spin2{transform-box:fill-box;transform-origin:center;animation:spin 25s linear infinite reverse}
    .scan{animation:scan 3.6s linear infinite}
    .blink{animation:blink 1.2s steps(2,end) infinite}
    .dash{stroke-dasharray:8 12;animation:dash 2.5s linear infinite}
    @keyframes pulse{50%{opacity:.38}}
    @keyframes float{50%{transform:translateY(-7px)}}
    @keyframes spin{to{transform:rotate(360deg)}}
    @keyframes scan{0%{transform:translateY(-40px);opacity:0}10%{opacity:1}90%{opacity:1}100%{transform:translateY(500px);opacity:0}}
    @keyframes blink{50%{opacity:.25}}
    @keyframes dash{to{stroke-dashoffset:-40}}
  </style>
</defs>

